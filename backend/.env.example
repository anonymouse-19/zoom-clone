# Copy this file to `.env` and adjust. Every value here has a default in app/config.py,
# so the app also runs with no .env at all during local development.

# SQLAlchemy connection string. A relative SQLite path is created next to where uvicorn runs.
DATABASE_URL=sqlite:///./zoom_clone.db

# Comma-separated list of browser origins allowed to call this API (CORS).
# In production, set this to your Vercel URL, e.g. https://zoom-clone.vercel.app
CORS_ORIGINS=http://localhost:3000

# Base URL of the frontend. Used to build invite links like {FRONTEND_URL}/j/12345678901
FRONTEND_URL=http://localhost:3000
