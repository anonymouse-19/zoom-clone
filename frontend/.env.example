# Copy to `.env.local` and adjust. NEXT_PUBLIC_ variables are inlined into the browser
# bundle at BUILD time, so changing them requires restarting `npm run dev` or rebuilding.
# Never put secrets in a NEXT_PUBLIC_ variable: every visitor can read it.

# Base URL of the FastAPI backend (REST calls go to ${NEXT_PUBLIC_API_URL}/api/...).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Base URL of the meeting room WebSocket (same server as the API).
# Use wss:// in production, e.g. wss://zoom-clone-api.onrender.com
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Optional TURN relay for WebRTC when a direct connection is impossible (strict networks),
# e.g. from a free metered.ca plan: turn:<host>:443?transport=tcp. Leave empty locally;
# STUN alone works on the same network. These end up visible to visitors (see lib/config.ts).
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=
