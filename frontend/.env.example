# Copy to `.env.local` and adjust. NEXT_PUBLIC_ variables are inlined into the browser
# bundle at BUILD time, so changing them requires restarting `npm run dev` or rebuilding.
# Never put secrets in a NEXT_PUBLIC_ variable: every visitor can read it.

# Base URL of the FastAPI backend (REST calls go to ${NEXT_PUBLIC_API_URL}/api/...).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Base URL for WebSocket signaling (used from Phase 5). Use wss:// in production.
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# TURN relay server for WebRTC when a direct peer connection is impossible (Phase 5).
# Leave empty locally; STUN alone works on the same network.
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=
